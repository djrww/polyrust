bool` | `F` returns `true` for a char in string   |"},{"DocComment":" | `&&str`                  | is substring                              |"},{"DocComment":" | `&String`                | is substring                              |"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // &str"},{"DocComment":" assert_eq!(\"abaaa\".find(\"ba\"), Some(1));"},{"DocComment":" assert_eq!(\"abaaa\".find(\"bac\"), None);"},{"DocComment":""},{"DocComment":" // char"},{"DocComment":" assert_eq!(\"abaaa\".find('a'), Some(0));"},{"DocComment":" assert_eq!(\"abaaa\".find('b'), Some(1));"},{"DocComment":" assert_eq!(\"abaaa\".find('c'), None);"},{"DocComment":""},{"DocComment":" // &[char; N]"},{"DocComment":" assert_eq!(\"ab\".find(&['b', 'a']), Some(0));"},{"DocComment":" assert_eq!(\"abaaa\".find(&['a', 'z']), Some(0));"},{"DocComment":" assert_eq!(\"abaaa\".find(&['c', 'd']), None);"},{"DocComment":""},{"DocComment":" // &[char]"},{"DocComment":" assert_eq!(\"ab\".find(&['b', 'a'][..]), Some(0));"},{"DocComment":" assert_eq!(\"abaaa\".find(&['a', 'z'][..]), Some(0));"},{"DocComment":" assert_eq!(\"abaaa\".find(&['c', 'd'][..]), None);"},{"DocComment":""},{"DocComment":" // FnMut(char) -> bool"},{"DocComment":" assert_eq!(\"abcdef_z\".find(|ch| ch > 'd' && ch < 'y'), Some(4));"},{"DocComment":" assert_eq!(\"abcddd_z\".find(|ch| ch > 'd' && ch < 'y'), None);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":99,"col":19},"end":{"line":99,"col":24}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{