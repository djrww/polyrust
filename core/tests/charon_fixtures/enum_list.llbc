ent":["core",0]},{"Ident":["marker",0]},{"Ident":["Sized",0]}],"span":{"Untagged":{"data":{"file_id":4,"beg":{"line":158,"col":0},"end":{"line":158,"col":26}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types with a constant size known at compile time."},{"DocComment":""},{"DocComment":" All type parameters have an implicit bound of `Sized`. The special syntax"},{"DocComment":" `?Sized` can be used to remove this bound if it's not appropriate."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" struct Foo<T>(T);"},{"DocComment":" struct Bar<T: ?Sized>(T);"},{"DocComment":""},{"DocComment":" // struct FooUse(Foo<[i32]>); // error: Sized is not implemented for [i32]"},{"DocComment":" struct BarUse(Bar<[i32]>); // OK"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The one exception is the implicit `Self` type of a trait. A trait does not"},{"DocComment":" have an implicit `Sized` bound as this is incompatible with [trait object]s"},{"DocComment":" where, by definition, the trait needs to work with all possible implementors,"},{"DocComment":" and thus could be any size."},{"DocComment":""},{"DocComment":" Although Rust will let you bind `Sized` to a trait, you won't"},{"DocComment":" be able to use it to form a trait object later:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(unused_variables)]"},{"DocComment":" trait Foo { }"},{"DocComment":" trait Bar: Sized { }"},{"DocComment":""},{"DocComment":" struct Impl;"},{"DocComment":" impl Foo for Impl { }"},{"DocComment":" impl Bar for Impl { }"},{"DocComment":""},{"DocComment":" let x: &dyn Foo = &Impl;    // OK"},{"DocComment":" // let y: &dyn Bar = &Impl; // error: the trait `Bar` cannot be made into an object"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [trait object]: ../../book/ch17-02-trait-objects.html"},{"Builtin":"Fundamental"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Sized","diagnostic_item":null},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[34,{"data":{"file_id":4,"beg":{"line":158,"col":17},"end":{"line":158,"col":26}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":6}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[],"vtable":null},{"def_id":2,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["alloc",0]},{"Ident":["Allocator",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":201,"col":0},"end":{"line":201,"col":32}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An implementation of `Allocator` can allocate, grow, shrink, and deallocate arbitrary blocks of"},{"DocComment":" data described via [`Layout`][]."},{"DocComment":""},{"DocComment":" `Allocator` is mostly designed to be implemented on ZSTs, references, or smart pointers,"},{"DocComment":" but can also be implemented directly on the underlying memory-owning type so long as it"},{"DocComment":" upholds the necessary guarantees. In general, an allocator of the type `MyAlloc([u8; N])`"},{"DocComment":" cannot be soundly created without being pinned or otherwise immovable in order to be"},{"DocComment":" correct."},{"DocComment":""},{"DocComment":" In contrast to [`GlobalAlloc`][], `Allocator` allows zero-sized allocations. If an underlying"},{"DocComment":" allocator does not support this (like jemalloc) or responds by returning a null pointer"},{"DocComment":" (such as `libc::malloc`), this must be caught by the implementation."},{"DocComment":""},{"DocComment":" In order to be usable in a flexible manner while still being sound, implementors of the trait"},{"DocComment":" must uphold very detailed semantics as explained below; the following terms are thus provided"},{"DocComment":" as vocabulary for allocator safety and implementation requirements:"},{"DocComment":""},{"DocComment":" ### Equivalent allocators"},{"DocComment":""},{"DocComment":" Multiple allocator values can sometimes be interchangeable with each other."},{"DocComment":" When this is the case, we refer to those allocators as being *equivalent* to"},{"DocComment":" each other."},{"DocComment":""},{"DocComment":" Users of allocators may assume the following are true of equivalent allocators,"},{"DocComment":" and implementors must ensure these rules are upheld:"},{"DocComment":" * An allocator is equivalent to itself. (Equivalence is reflexive.)"},{"DocComment":" * If an allocator is equivalent to a second allocator, then"},{"DocComment":"   the second allocator is also equivalent to the first. (Equivalence is symmetric.)"},{"DocComment":" * If an allocator is equivalent to a second allocator, and"},{"DocComment":"   the second allocator is equivalent to a third allocator, then"},{"DocComment":"   the first allocator is also equivalent to the third allocator."},{"DocComment":"   (Equivalence is transitive.)"},{"DocComment":" * Moving, subtyping, unsize-coercing, or trait-upcasting an allocator does not change"},{"DocComment":"   what the allocator is equivalent to."},{"DocComment":" * Copying or cloning an allocator creates an equivalent one, should the"},{"DocComment":"   [`AllocatorClone`] trait be implemented."},{"DocComment":""},{"DocComment":" Additionally, implementors of `Allocator` may specify additional equivalences"},{"DocComment":" between allocators. It is the responsibility of such implementors to make sure"},{"DocComment":" that equivalent allocators have \"compatible\" `Allocator` implementations."},{"DocComment":" In particular, the standard library specifies the following equivalences:"},{"DocComment":" * A reference to an allocator (either `&` or `&mut`) is equivalent to"},{"DocComment":"   the allocator being referenced."},{"DocComment":" * A `Box`, `Rc`, or `Arc` containing an allocator is equivalent to"},{"DocComment":"   the allocator inside."},{"DocComment":" * All `Global` allocator instances are equivalent with each other."},{"DocComment":" * All `System` allocator instances are equivalent with each other."},{"DocComment":""},{"DocComment":" ### Currently allocated memory"},{"DocComment":""},{"DocComment":" Some of the methods require that a memory block is *currently allocated* by some specific allocator."},{"DocComment":" This means that:"},{"DocComment":" * the starting address for that memory block was previously returned by"},{"DocComment":"   the [`allocate`], [`allocate_zeroed`], [`grow`], [`grow_zeroed`], or [`shrink`] methods,"},{"DocComment":"   called on an allocator that's equivalent to this specific allocator; and"},{"DocComment":" * the memory block has not subsequently been [*invalidated*]."},{"DocComment":""},{"DocComment":" ### Invalidating memory blocks"},{"DocComment":""},{"DocComment":" A memory block that is currently allocated becomes *invalidated* when one"},{"DocComment":" of the following happens:"},{"DocComment":" * The memory block is deallocated. This occurs when the memory block"},{"DocComment":"   is passed as an argument to a [`deallocate`] call, or when it is passed"},{"DocComment":"   as an argument to a [`grow`], [`grow_zeroed`] or [`shrink`] call that returns `Ok`."},{"DocComment":" * For all (equivalent) allocators that this memory block is currently allocated by, at"},{"DocComment":"   least one of the following has occurred:"},{"DocComment":"   * The allocator's destructor runs."},{"DocComment":"   * The allocator is mutated through a public or otherwise untrusted API taking `&mut` access."},{"DocComment":"   * One of the borrow-checker lifetimes in the allocator's type expires."},{"DocComment":""},{"DocComment":" Note that these conditions imply that a collection may ensure that"},{"DocComment":" any specific currently allocated memory block won't be invalidated by:"},{"DocComment":" * not deallocating that memory block,"},{"DocComment":" * owning an allocator that memory block is allocated with, and"},{"DocComment":" * not publicly exposing `&mut` access to that allocator."},{"DocComment":""},{"DocComment":" Also note that safe public API of an allocator with `&` access is not"},{"DocComment":" allowed to invalidate its memory blocks. Furthermore, unsafe public API"},{"DocComment":" of an allocator with `&` access must document that they invalidate"},{"DocComment":" memory blocks (e.g., by calling `deallocate`) if they do. Therefore,"},{"DocComment":" a collection may safely expose `&` access to its allocator."},{"DocComment":""},{"DocComment":" Also note that, even in cases where there are other \"alive\" allocators known"},{"DocComment":" to be equivalent to a given collection's allocator, most collections still should"},{"DocComment":" not publicly expose `&mut` access to their allocators. The fact that there are"},{"DocComment":" other \"alive\" allocators would prevent this `&mut` access from invalidating"},{"DocComment":" the collection's memory block, but public `&mut` access is still likely to"},{"DocComment":" be unsound, since a user could replace the collection's allocator with"},{"DocComment":" a non-equivalent allocator, causing the collection to deallocate its memory"},{"DocComment":" with the wrong allocator."},{"DocComment":""},{"DocComment":" [`allocate`]: Allocator::allocate"},{"DocComment":" [`allocate_zeroed`]: Allocator::allocate_zeroed"},{"DocComment":" [`grow`]: Allocator::grow"},{"DocComment":" [`grow_zeroed`]: Allocator::grow_zeroed"},{"DocComment":" [`shrink`]: Allocator::shrink"},{"DocComment":" [`deallocate`]: Allocator::deallocate"},{"DocComment":""},{"DocComment":" ### Memory fitting"},{"DocComment":""},{"DocComment":" Some of the methods require that a `layout` *fits* a memory block or vice versa. This means"},{"DocComment":" that the following conditions must hold:"},{"DocComment":"  * the memory block must be *currently allocated* with alignment of [`layout.align()`], and"},{"DocComment":"  * [`layout.size()`] must fall in the range `min ..= max`, where:"},{"DocComment":"    - `min` is the size of the layout used to allocate the block, and"},{"DocComment":"    - `max` is the actual size returned from [`allocate`], [`allocate_zeroed`],"},{"DocComment":"      [`grow`], [`grow_zeroed`], or [`shrink`]."},{"DocComment":""},{"DocComment":" [`layout.align()`]: Layout::align"},{"DocComment":" [`layout.size()`]: Layout::size"},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Implementors of `Allocator` must ensure that a memory block that"},{"DocComment":" is [*currently allocated*] by the allocator points to valid memory"},{"DocComment":" until that memory block is [*invalidated*]. The implementor must also"},{"DocComment":" not violate this invariant of `Allocator` via allocator equivalences"},{"DocComment":" that are in the implementor's control."},{"DocComment":""},{"DocComment":" Additionally, any memory block returned by the allocator must"},{"DocComment":" satisfy the allocation invariants described in `core::ptr`."},{"DocComment":" In particular, if a block has base address `p` and size `n`,"},{"DocComment":" then `p as usize + n <= usize::MAX` must hold. These blocks must also"},{"DocComment":" be wholly disjoint."},{"DocComment":""},{"DocComment":" This ensures that pointer arithmetic within the allocation"},{"DocComment":" (for example, `ptr.add(len)`) cannot overflow the address space, and"},{"DocComment":" that it is possible to perform nonoverlapping copies between allocations."},{"DocComment":""},{"DocComment":" None of the allocating or deallocating methods may unwind. This restriction"},{"DocComment":" may be lifted in the future by ensuring unwinding out of an allocating function always"},{"DocComment":" aborts. If an implementor of `Allocator` also has drop glue or directly implements `Drop`,"},{"DocComment":" dropping the allocator must not result in an unwind."},{"DocComment":""},{"DocComment":" It is undefined behavior for the allocator to read, write, or deallocate any memory that"},{"DocComment":" is currently allocated. This memory is owned by the user; the allocator must not touch it."},{"DocComment":""},{"DocComment":" Lastly, the methods on this trait must be *correct*; in particular, the layout requested"},{"DocComment":" must be respected, calls must zero out memory if the documentation so requires,"},{"DocComment":" returning an `AllocError` from a reallocating method must indeed ensure that"},{"DocComment":" the old pointer was not invalidated, and de/reallocating calls must accept layouts"},{"DocComment":" in the ranges defined by their documentation."},{"DocComment":""},{"DocComment":" [*currently allocated*]: #currently-allocated-memory"},{"DocComment":" [*invalidated*]: #invalidating-memory-blocks"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[35,{"data":{"file_id":6,"beg":{"line":201,"col":0},"end":{"line":466,"col":1}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":6}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"allocate","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["alloc",0]},{"Ident":["Allocator",0]},{"Ident":["allocate",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":234,"col":4},"end":{"line":234,"col":76}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Attempts to allocate a block of memory."},{"DocComment":""},{"DocComment":" On success, returns a [`NonNull<[u8]>`][NonNull] meeting the size and alignment"},{"DocComment":" guarantees of `layout`. The returned block may have a larger size than specified"},{"DocComment":" by `layout.size()`, and may or may not have its contents initialized."},{"DocComment":""},{"DocComment":" It is recommended that overallocating as per the above is only performed if doing so"},{"DocComment":" is cheap; there is no guarantee that the caller is able to take advantage of the"},{"DocComment":" returned excess. Implementors are free to e.g. provide an alternate method to query"},{"DocComment":" available excess if doing so is expensive and should be left to the caller."},{"DocComment":""},{"DocComment":" Note that the returned block of memory is considered [*currently allocated*]"},{"DocComment":" with this allocator (and equivalent allocators)."},{"DocComment":" Therefore, it is the responsibility of implementors of `Allocator` to make sure that"},{"DocComment":" this block of memory remains valid until it is [*invalidated*]."},{"DocComment":""},{"DocComment":" [*currently allocated*]: #currently-allocated-memory"},{"DocComment":" [*invalidated*]: #invalidating-memory-blocks"},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" Returning `Err` indicates that either memory is exhausted or `layout` does not meet"},{"DocComment":" allocator's size or alignment constraints."},{"DocComment":""},{"DocComment":" Implementations are encouraged to return `Err` on memory exhaustion rather than"},{"DocComment":" aborting, but this is not a strict requirement. (Specifically: it is *legal* to implement"},{"DocComment":" this trait atop an underlying native allocation library that aborts on memory exhaustion.)"},{"DocComment":""},{"DocComment":" Clients wishing to abort computation in response to an allocation error are encouraged to"},{"DocComment":" call the [`handle_alloc_error`] function, rather than directly invoking `panic!` or similar."},{"DocComment":""},{"DocComment":" [`handle_alloc_error`]: ../../alloc/alloc/fn.handle_alloc_error.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[77,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":6},"Shared"]}]},{"Deduplicated":59}],"output":{"Deduplicated":60}},"default":null},"kind":{"TraitMethod":[2,0]}},null,{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"deallocate","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["alloc",0]},{"Ident":["Allocator",0]},{"Ident":["deallocate",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":274,"col":4},"end":{"line":274,"col":66}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Deallocates the memory referenced by `ptr`."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" * `ptr` must denote a block of memory [*currently allocated*] via this allocator, and"},{"DocComment":" * `layout` must [*fit*] that block of memory."},{"DocComment":""},{"DocComment":" Note that it is *immediate* language UB for a deallocation or reallocation to"},{"DocComment":" invalidate any outstanding references, smart pointers, etc.; thus, notably, an"},{"DocComment":" allocator that has been moved into its own [*currently allocated*] memory may"},{"DocComment":" not have its backing memory be freed, even if the allocator is never used again"},{"DocComment":" afterwards. This is due to the fact that such a deallocation would invalidate the"},{"DocComment":" `&self` reference passed to this method."},{"DocComment":""},{"DocComment":" [*currently allocated*]: #currently-allocated-memory"},{"DocComment":" [*fit*]: #memory-fitting"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":77},{"Deduplicated":63},{"Deduplicated":59}],"output":{"Deduplicated":19}},"default":null},"kind":{"TraitMethod":[2,2]}},null,null,null],"vtable":{"id":6,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":3,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Debug",0]}],"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":1053,"col":0},"end":{"line":1053,"col":29}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `?` formatting."},{"DocComment":""},{"DocComment":" `Debug` should format the output in a programmer-facing, debugging context."},{"DocComment":""},{"DocComment":" Generally speaking, you should just `derive` a `Debug` implementation."},{"DocComment":""},{"DocComment":" When used with the alternate format specifier `#?`, the output is pretty-printed."},{"DocComment":""},{"DocComment":" For more information on formatters, see [the module-level documentation][module]."},{"DocComment":""},{"DocComment":" [module]: ../../std/fmt/index.html"},{"DocComment":""},{"DocComment":" This trait can be used with `#[derive]` if all fields implement `Debug`. When"},{"DocComment":" `derive`d for structs, it will use the name of the `struct`, then `{`, then a"},{"DocComment":" comma-separated list of each field's name and `Debug` value, then `}`. For"},{"DocComment":" `enum`s, it will use the name of the variant and, if applicable, `(`, then the"},{"DocComment":" `Debug` values of the fields, then `)`."},{"DocComment":""},{"DocComment":" # Stability"},{"DocComment":""},{"DocComment":" Derived `Debug` formats are not stable, and so may change with future Rust"},{"DocComment":" versions. Additionally, `Debug` implementations of types provided by the"},{"DocComment":" standard library (`std`, `core`, `alloc`, etc.) are not stable, and"},{"DocComment":" may also change with future Rust versions."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Deriving an implementation:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     format!(\"The origin is: {origin:?}\"),"},{"DocComment":"     \"The origin is: Point { x: 0, y: 0 }\","},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Manually implementing:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Debug for Point {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         f.debug_struct(\"Point\")"},{"DocComment":"          .field(\"x\", &self.x)"},{"DocComment":"          .field(\"y\", &self.y)"},{"DocComment":"          .finish()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     format!(\"The origin is: {origin:?}\"),"},{"DocComment":"     \"The origin is: Point { x: 0, y: 0 }\","},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There are a number of helper methods on the [`Formatter`] struct to help you with manual"},{"DocComment":" implementations, such as [`debug_struct`]."},{"DocComment":""},{"DocComment":" [`debug_struct`]: Formatter::debug_struct"},{"DocComment":""},{"DocComment":" Types that do not wish to use the standard suite of debug representations"},{"DocComment":" provided by the `Formatter` trait (`debug_struct`, `debug_tuple`,"},{"DocComment":" `debug_list`, `debug_set`, `debug_map`) can do something totally custom by"},{"DocComment":" manually writing an arbitrary representation to the `Formatter`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use std::fmt;"},{"DocComment":" # struct Point {"},{"DocComment":" #     x: i32,"},{"DocComment":" #     y: i32,"},{"DocComment":" # }"},{"DocComment":" #"},{"DocComment":" impl fmt::Debug for Point {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"Point [{} {}]\", self.x, self.y)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `Debug` implementations using either `derive` or the debug builder API"},{"DocComment":" on [`Formatter`] support pretty-printing using the alternate flag: `{:#?}`."},{"DocComment":""},{"DocComment":" Pretty-printing with `#?`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" let expected = \"The origin is: Point {"},{"DocComment":"     x: 0,"},{"DocComment":"     y: 0,"},{"DocComment":" }\";"},{"DocComment":" assert_eq!(format!(\"The origin is: {origin:#?}\"), expected);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Debug"},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"fmt","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Debug",0]},{"Ident":["fmt",0]}],"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":1084,"col":4},"end":{"line":1084,"col":51}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":"Formats the value using the given formatter.\n\n# Errors\n\nThis function should return [`Err`] if, and only if, the provided [`Formatter`] returns [`Err`].\nString formatting is considered an infallible operation; this function only\nreturns a [`Result`] because writing to the underlying stream might fail and it must\nprovide a way to propagate the fact that an error has occurred back up the stack.\n"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Position {"},{"DocComment":"     longitude: f32,"},{"DocComment":"     latitude: f32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Debug for Position {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         f.debug_tuple(\"\")"},{"DocComment":"          .field(&self.longitude)"},{"DocComment":"          .field(&self.latitude)"},{"DocComment":"          .finish()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let position = Position { longitude: 1.987, latitude: 2.983 };"},{"DocComment":" assert_eq!(format!(\"{position:?}\"), \"(1.987, 2.983)\");"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"{position:#?}\"), \"("},{"DocComment":"     1.987,"},{"DocComment":"     2.983,"},{"DocComment":" )\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":77},{"Deduplicated":20}],"output":{"Deduplicated":22}},"default":null},"kind":{"TraitMethod":[3,0]}}],"vtable":{"id":11,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}],"trait_impls":[{"def_id":0,"item_meta":{"name":[{"Ident":["input",0]},{"Impl":{"Trait":0}}],"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":1,"col":9},"end":{"line":1,"col":14}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"Builtin":"AutomaticallyDerived"}],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"src":"Normal","impl_trait":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":4}],"const_generics":[],"trait_refs":[]}},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"id":1,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bou