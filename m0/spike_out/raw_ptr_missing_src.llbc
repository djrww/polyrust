data",0]},{"Ident":["Thin",0]}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":85,"col":0},"end":{"line":85,"col":14}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Pointers to types implementing this trait alias are “thin”."},{"DocComment":""},{"DocComment":" This includes statically-`Sized` types and `extern` types."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" #![feature(ptr_metadata)]"},{"DocComment":""},{"DocComment":" fn this_never_panics<T: std::ptr::Thin>() {"},{"DocComment":"     assert_eq!(size_of::<&T>(), size_of::<usize>())"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"TraitAlias","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[{"regions":[],"skip_binder":{"trait_ref":{"Untagged":{"kind":{"ParentClause":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[2,0]}}}],"const_generics":[],"trait_refs":[]}}}}},0]},"trait_decl_ref":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[2,0]}}}],"const_generics":[],"trait_refs":[]}}}}},"type_id":0,"ty":{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}}}}]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":85,"col":17},"end":{"line":85,"col":39}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[1,0]}}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[],"vtable":null},{"def_id":1,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["metadata",0]},{"Ident":["Pointee",0]}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":59,"col":0},"end":{"line":59,"col":31}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Provides the pointer metadata type of any pointed-to type."},{"DocComment":""},{"DocComment":" # Pointer metadata"},{"DocComment":""},{"DocComment":" Raw pointer types and reference types in Rust can be thought of as made of two parts:"},{"DocComment":" a data pointer that contains the memory address of the value, and some metadata."},{"DocComment":""},{"DocComment":" For statically-sized types (that implement the `Sized` traits)"},{"DocComment":" as well as for `extern` types,"},{"DocComment":" pointers are said to be “thin”: metadata is zero-sized and its type is `()`."},{"DocComment":""},{"DocComment":" Pointers to [dynamically-sized types][dst] are said to be “wide” or “fat”,"},{"DocComment":" they have non-zero-sized metadata:"},{"DocComment":""},{"DocComment":" * For structs whose last field is a DST, metadata is the metadata for the last field"},{"DocComment":" * For the `str` type, metadata is the length in bytes as `usize`"},{"DocComment":" * For slice types like `[T]`, metadata is the length in items as `usize`"},{"DocComment":" * For trait objects like `dyn SomeTrait`, metadata is [`DynMetadata<Self>`][DynMetadata]"},{"DocComment":"   (e.g. `DynMetadata<dyn SomeTrait>`)"},{"DocComment":""},{"DocComment":" In the future, the Rust language may gain new kinds of types"},{"DocComment":" that have different pointer metadata."},{"DocComment":""},{"DocComment":" [dst]: https://doc.rust-lang.org/nomicon/exotic-sizes.html#dynamically-sized-types-dsts"},{"DocComment":""},{"DocComment":""},{"DocComment":" # The `Pointee` trait"},{"DocComment":""},{"DocComment":" The point of this trait is its `Metadata` associated type,"},{"DocComment":" which is `()` or `usize` or `DynMetadata<_>` as described above."},{"DocComment":" It is automatically implemented for every type."},{"DocComment":" It can be assumed to be implemented in a generic context, even without a corresponding bound."},{"DocComment":""},{"DocComment":""},{"DocComment":" # Usage"},{"DocComment":""},{"DocComment":" Raw pointers can be decomposed into the data pointer and metadata components"},{"DocComment":" with their [`to_raw_parts`] method."},{"DocComment":""},{"DocComment":" Alternatively, metadata alone can be extracted with the [`metadata`] function."},{"DocComment":" A reference can be passed to [`metadata`] and implicitly coerced."},{"DocComment":""},{"DocComment":" A (possibly-wide) pointer can be put back together from its data pointer and metadata"},{"DocComment":" with [`from_raw_parts`] or [`from_raw_parts_mut`]."},{"DocComment":""},{"DocComment":" [`to_raw_parts`]: *const::to_raw_parts"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"PointeeTrait","diagnostic_item":null},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":67,"col":4},"end":{"line":67,"col":81}},"generated_from_span":null}},"origin":{"TraitItem":0},"trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[2,0]}}}],"const_generics":[],"trait_refs":[]}}}}},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":67,"col":19},"end":{"line":67,"col":29}},"generated_from_span":n