ment":""},{"DocComment":" For example,"},{"DocComment":" `Result<T, E>: Try<Output = T, Residual = Result<!, E>>`,"},{"DocComment":" and in the other direction,"},{"DocComment":" `<Result<!, E> as Residual<T>>::TryType = Result<T, E>`."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"O","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[{"regions":[],"skip_binder":{"trait_ref":{"Untagged":{"kind":{"ParentClause":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[2,0]}}},{"Untagged":{"TypeVar":{"Bound":[2,1]}}}],"const_generics":[],"trait_refs":[]}}}}},3]},"trait_decl_ref":{"regions":[],"skip_binder":{"id":11,"generics":{"regions":[],"types":[{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[3,0]}}},{"Untagged":{"TypeVar":{"Bound":[3,1]}}}],"const_generics":[],"trait_refs":[]}}}}},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}}],"const_generics":[],"trait_refs":[]}}}}},"type_id":0,"ty":{"Untagged":{"TypeVar":{"Bound":[1,1]}}}}},{"regions":[],"skip_binder":{"trait_ref":{"Untagged":{"kind":{"ParentClause":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[2,0]}}},{"Untagged":{"TypeVar":{"Bound":[2,1]}}}],"const_generics":[],"trait_refs":[]}}}}},3]},"trait_decl_ref":{"regions":[],"skip_binder":{"id":11,"generics":{"regions":[],"types":[{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":12,"generics":{"regions":[],"t