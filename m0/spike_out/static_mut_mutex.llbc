rated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A type of error which can be returned whenever a lock is acquired."},{"DocComment":""},{"DocComment":" Both [`Mutex`]es and [`RwLock`]s are poisoned whenever a thread fails while the lock"},{"DocComment":" is held. The precise semantics for when a lock is poisoned is documented on"},{"DocComment":" each lock. For a lock in the poisoned state, unless the state is cleared manually,"},{"DocComment":" all future acquisitions will return this error."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::sync::{Arc, Mutex};"},{"DocComment":" use std::thread;"},{"DocComment":""},{"DocComment":" let mutex = Arc::new(Mutex::new(1));"},{"DocComment":""},{"DocComment":" // poison the mutex"},{"DocComment":" let c_mutex = Arc::clone(&mutex);"},{"DocComment":" let _ = thread::spawn(move || {"},{"DocComment":"     let mut data = c_mutex.lock().unwrap();"},{"DocComment":"     *data = 2;"},{"DocComment":"     panic!();"},{"DocComment":" }).join();"},{"DocComment":""},{"DocComment":" match mutex.lock() {"},{"DocComment":"     Ok(_) => unreachable!(),"},{"DocComment":"     Err(p_err) => {"},{"DocComment":"         let data = p_err.get_ref();"},{"DocComment":"         println!(\"recovered: {data}\");"},{"DocComment":"     }"},{"DocComment":" };"},{"DocComment":" ```"},{"DocComment":" [`Mutex`]: crate::sync::Mutex"},{"DocComment":" [`RwLock`]: crate::sync::RwLock"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Covariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[8,{"data":{"file_id":2,"beg":{"line":194,"col":23},"end":{"line":194,"col":24}},"generated_from_span":null}]},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types