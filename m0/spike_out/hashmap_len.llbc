[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Impl":{"Trait":0}},{"Builtin":["VTable",0]}]},{"key":{"Fun":6},"value":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Impl":{"Trait":0}},{"Ident":["allocate",0]}]},{"key":{"Fun":7},"value":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Impl":{"Trait":0}},{"Ident":["allocate_zeroed",0]}]},{"key":{"Fun":8},"value":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Impl":{"Trait":0}},{"Ident":["deallocate",0]}]},{"key":{"Fun":9},"value":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Impl":{"Trait":0}},{"Ident":["grow",0]}]},{"key":{"Fun":10},"value":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Impl":{"Trait":0}},{"Ident":["grow_zeroed",0]}]},{"key":{"Fun":11},"value":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Impl":{"Trait":0}},{"Ident":["shrink",0]}]},{"key":{"Fun":12},"value":[{"Ident":["std",0]},{"Ident":["collections",0]},{"Ident":["hash",0]},{"Ident":["map",0]},{"Ident":["HashMap",0]},{"Impl":{"Trait":1}},{"Builtin":["DropGlue",0]}]}],"assoc_item_names":[{"types":[],"methods":[],"consts":[]},{"types":[],"methods":[],"consts":[]},{"types":[],"methods":["allocate","allocate_zeroed","deallocate","grow","grow_zeroed","shrink"],"consts":[]},{"types":[],"methods":["drop_glue"],"consts":[]}],"short_names":[{"key":{"TraitImpl":0},"value":[{"Ident":["impl_Allocator_for_Global",0]}]},{"key":{"TraitImpl":1},"value":[{"Ident":["impl_Destruct_for_HashMap",0]}]},{"key":{"Global":1},"value":[{"Impl":{"Trait":0}},{"Builtin":["VTable",0]}]},{"key":{"Fun":6},"value":[{"Ident":["allocate",0]}]},{"key":{"Fun":7},"value":[{"Impl":{"Trait":0}},{"Ident":["allocate_zeroed",0]}]},{"key":{"Fun":8},"value":[{"Ident":["deallocate",0]}]},{"key":{"Fun":9},"value":[{"Impl":{"Trait":0}},{"Ident":["grow",0]}]},{"key":{"Fun":10},"value":[{"Impl":{"Trait":0}},{"Ident":["grow_zeroed",0]}]},{"key":{"Fun":11},"value":[{"Impl":{"Trait":0}},{"Ident":["shrink",0]}]},{"key":{"Fun":12},"value":[{"Builtin":["DropGlue",0]}]},{"key":{"Type":8},"value":[{"Ident":["NonNull",0]}]},{"key":{"Type":1},"value":[{"Ident":["HashMap",0]}]},{"key":{"Type":2},"value":[{"Ident":["RandomState",0]}]},{"key":{"TraitDecl":1},"value":[{"Ident":["MetaSized",0]}]},{"key":{"Fun":0},"value":[{"Ident":["map_len",0]}]},{"key":{"Fun":1},"value":[{"Ident":["len",0]}]},{"key":{"Type":6},"value":[{"Ident":["Layout",0]}]},{"key":{"TraitDecl":3},"value":[{"Ident":["Destruct",0]}]},{"key":{"Type":9},"value":[{"Ident":["AllocError",0]}]},{"key":{"Type":7},"value":[{"Ident":["Result",0]}]},{"key":{"TraitDecl":2},"value":[{"Ident":["Allocator",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["Sized",0]}]},{"key":{"Type":3},"value":[{"Ident":["Global",0]}]}],"type_decls":[{"def_id":0,"item_meta":{"name":[{"Builtin":[{"Tuple":0},0]}],"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":{"Builtin":"Tuple"},"kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","0"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":{"Untagged":{"AtLeast":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","0"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}}}}},"align":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","1"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":{"Untagged":{"AtLeast":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","1"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}}}}},"discriminator":{"Known":0},"inhabited":{"Untagged":"True"},"variant_layouts":[{"field_offsets":[],"inhabited":{"Untagged":"True"},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":1,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["collections",0]},{"Ident":["hash",0]},{"Ident":["map",0]},{"Ident":["HashMap",0]}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":245,"col":0},"end":{"line":250,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A [hash map] implemented with quadratic probing and SIMD lookup."},{"DocComment":""},{"DocComment":" By default, `HashMap` uses a hashing algorithm selected to provide"},{"DocComment":" resistance against HashDoS attacks. The algorithm is randomly seeded, and a"},{"DocComment":" reasonable best-effort is made to generate this seed from a high quality,"},{"DocComment":" secure source of randomness provided by the host without blocking the"},{"DocComment":" program. Because of this, the randomness of the seed depends on the output"},{"DocComment":" quality of the system's random number generator when the seed is created."},{"DocComment":" In particular, seeds generated when the system's entropy pool is abnormally"},{"DocComment":" low such as during system boot may be of a lower quality."},{"DocComment":""},{"DocComment":" The default hashing algorithm is currently SipHash 1-3, though this is"},{"DocComment":" subject to change at any point in the future. While its performance is very"},{"DocComment":" competitive for medium sized keys, other hashing algorithms will outperform"},{"DocComment":" it for small keys such as integers as well as large keys such as long"},{"DocComment":" strings, though those algorithms will typically *not* protect against"},{"DocComment":" attacks such as HashDoS."},{"DocComment":""},{"DocComment":" The hashing algorithm can be replaced on a per-`HashMap` basis using the"},{"DocComment":" [`default`], [`with_hasher`], and [`with_capacity_and_hasher`] methods."},{"DocComment":" There are many alternative [hashing algorithms available on crates.io]."},{"DocComment":""},{"DocComment":" It is required that the keys implement the [`Eq`] and [`Hash`] traits, although"},{"DocComment":" this can frequently be achieved by using `#[derive(PartialEq, Eq, Hash)]`."},{"DocComment":" If you implement these yourself, it is important that the following"},{"DocComment":" property holds:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" k1 == k2 -> hash(k1) == hash(k2)"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In other words, if two keys are equal, their hashes must be equal."},{"DocComment":" Violating this property is a logic error."},{"DocComment":""},{"DocComment":" It is also a logic error for a key to be modified in such a way that the key's"},{"DocComment":" hash, as determined by the [`Hash`] trait, or its equality, as determined by"},{"DocComment":" the [`Eq`] trait, changes while it is in the map. This is normally only"},{"DocComment":" possible through [`Cell`], [`RefCell`], global state, I/O, or unsafe code."},{"DocComment":""},{"DocComment":" The behavior resulting from either logic error is not specified, but will"},{"DocComment":" be encapsulated to the `HashMap` that observed the logic error and not"},{"DocComment":" result in undefined behavior. This could include panics, incorrect results,"},{"DocComment":" aborts, memory leaks, and non-termination."},{"DocComment":""},{"DocComment":" The hash table implementation is a Rust port of Google's [SwissTable]."},{"DocComment":" The original C++ version of SwissTable can be found [here], and this"},{"DocComment":" [CppCon talk] gives an overview of how the algorithm works."},{"DocComment":""},{"DocComment":" [hash map]: crate::collections#use-a-hashmap-when"},{"DocComment":" [hashing algorithms available on crates.io]: https://crates.io/keywords/hasher"},{"DocComment":" [SwissTable]: https://abseil.io/blog/20180927-swisstables"},{"DocComment":" [here]: https://github.com/abseil/abseil-cpp/blob/master/absl/container/internal/raw_hash_set.h"},{"DocComment":" [CppCon talk]: https://www.youtube.com/watch?v=ncHmEUmJZf4"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" // Type inference lets us omit an explicit type signature (which"},{"DocComment":" // would be `HashMap<String, String>` in this example)."},{"DocComment":" let mut book_reviews = HashMap::new();"},{"DocComment":""},{"DocComment":" // Review some books."},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"Adventures of Huckleberry Finn\".to_string(),"},{"DocComment":"     \"My favorite book.\".to_string(),"},{"DocComment":" );"},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"Grimms' Fairy Tales\".to_string(),"},{"DocComment":"     \"Masterpiece.\".to_string(),"},{"DocComment":" );"},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"Pride and Prejudice\".to_string(),"},{"DocComment":"     \"Very enjoyable.\".to_string(),"},{"DocComment":" );"},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"The Adventures of Sherlock Holmes\".to_string(),"},{"DocComment":"     \"Eye lyked it alot.\".to_string(),"},{"DocComment":" );"},{"DocComment":""},{"DocComment":" // Check for a specific one."},{"DocComment":" // When collections store owned values (String), they can still be"},{"DocComment":" // queried using references (&str)."},{"DocComment":" if !book_reviews.contains_key(\"Les Misérables\") {"},{"DocComment":"     println!(\"We've got {} reviews, but Les Misérables ain't one.\","},{"DocComment":"              book_reviews.len());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // oops, this review has a lot of spelling mistakes, let's delete it."},{"DocComment":" book_reviews.remove(\"The Adventures of Sherlock Holmes\");"},{"DocComment":""},{"DocComment":" // Look up the values associated with some keys."},{"DocComment":" let to_find = [\"Pride and Prejudice\", \"Alice's Adventure in Wonderland\"];"},{"DocComment":" for &book in &to_find {"},{"DocComment":"     match book_reviews.get(book) {"},{"DocComment":"         Some(review) => println!(\"{book}: {review}\"),"},{"DocComment":"         None => println!(\"{book} is unreviewed.\")"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Look up the value for a key (will panic if the key is not found)."},{"DocComment":" println!(\"Review for Jane: {}\", book_reviews[\"Pride and Prejudice\"]);"},{"DocComment":""},{"DocComment":" // Iterate over everything."},{"DocComment":" for (book, review) in &book_reviews {"},{"DocComment":"     println!(\"{book}: \\\"{review}\\\"\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A `HashMap` with a known list of items can be initialized from an array:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" let solar_distance = HashMap::from(["},{"DocComment":"     (\"Mercury\", 0.4),"},{"DocComment":"     (\"Venus\", 0.7),"},{"DocComment":"     (\"Earth\", 1.0),"},{"DocComment":"     (\"Mars\", 1.5),"},{"DocComment":" ]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## `Entry` API"},{"DocComment":""},{"DocComment":" `HashMap` implements an [`Entry` API](#method.entry), which allows"},{"DocComment":" for complex methods of getting, setting, updating and removing keys and"},{"DocComment":" their values:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" // type inference lets us omit an explicit type signature (which"},{"DocComment":" // would be `HashMap<&str, u8>` in this example)."},{"DocComment":" let mut player_stats = HashMap::new();"},{"DocComment":""},{"DocComment":" fn random_stat_buff() -> u8 {"},{"DocComment":"     // could actually return some random value here - let's just return"},{"DocComment":"     // some fixed value for now"},{"DocComment":"     42"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // insert a key only if it doesn't already exist"},{"DocComment":" player_stats.entry(\"health\").or_insert(100);"},{"DocComment":""},{"DocComment":" // insert a key using a function that provides a new value only if it"},{"DocComment":" // doesn't already exist"},{"DocComment":" player_stats.entry(\"defence\").or_insert_with(random_stat_buff);"},{"DocComment":""},{"DocComment":" // update a key, guarding against the key possibly not being set"},{"DocComment":" let stat = player_stats.entry(\"attack\").or_insert(100);"},{"DocComment":" *stat += random_stat_buff();"},{"DocComment":""},{"DocComment":" // modify an entry before an insert with in-place mutation"},{"DocComment":" player_stats.entry(\"mana\").and_modify(|mana| *mana += 200).or_insert(100);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Usage with custom key types"},{"DocComment":""},{"DocComment":" The easiest way to use `HashMap` with a custom key type is to derive [`Eq`] and [`Hash`]."},{"DocComment":" We must also derive [`PartialEq`]."},{"DocComment":""},{"DocComment":" [`RefCell`]: crate::cell::RefCell"},{"DocComment":" [`Cell`]: crate::cell::Cell"},{"DocComment":" [`default`]: Default::default"},{"DocComment":" [`with_hasher`]: Self::with_hasher"},{"DocComment":" [`with_capacity_and_hasher`]: Self::with_capacity_and_hasher"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" #[derive(Hash, Eq, PartialEq, Debug)]"},{"DocComment":" struct Viking {"},{"DocComment":"     name: String,"},{"DocComment":"     country: String,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Viking {"},{"DocComment":"     /// Creates a new Viking."},{"DocComment":"     fn new(name: &str, country: &str) -> Viking {"},{"DocComment":"         Viking { name: name.to_string(), country: country.to_string() }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Use a HashMap to store the vikings' health points."},{"DocComment":" let vikings = HashMap::from(["},{"DocComment":"     (Viking::new(\"Einar\", \"Norway\"), 25),"},{"DocComment":"     (Viking::new(\"Olaf\", \"Denmark\"), 24),"},{"DocComment":"     (Viking::new(\"Harald\", \"Iceland\"), 12),"},{"DocComment":" ]);"},{"DocComment":""},{"DocComment":" // Use derived implementation to print the status of the vikings."},{"DocComment":" for (viking, health) in &vikings {"},{"DocComment":"     println!(\"{viking:?} has {health} hp\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Usage in `const` and `static`"},{"DocComment":""},{"DocComment":" As explained above, `HashMap` is randomly seeded: each `HashMap` instance uses a different seed,"},{"DocComment":" which means that `HashMap::new` normally cannot be used in a `const` or `static` initializer."},{"DocComment":""},{"DocComment":" However, if you need to use a `HashMap` in a `const` or `static` initializer while retaining"},{"DocComment":" random seed generation, you can wrap the `HashMap` in [`LazyLock`]."},{"DocComment":""},{"DocComment":" Alternatively, you can construct a `HashMap` in a `const` or `static` initializer using a different"},{"DocComment":" hasher that does not rely on a random seed. **Be aware that a `HashMap` created this way is not"},{"DocComment":" resistant to HashDoS attacks!**"},{"DocComment":""},{"DocComment":" [`LazyLock`]: crate::sync::LazyLock"},{"DocComment":" ```rust"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":" use std::hash::{BuildHasherDefault, DefaultHasher};"},{"DocComment":" use std::sync::{LazyLock, Mutex};"},{"DocComment":""},{"DocComment":" // HashMaps with a fixed, non-random hasher"},{"DocComment":" const NONRANDOM_EMPTY_MAP: HashMap<String, Vec<i32>, BuildHasherDefault<DefaultHasher>> ="},{"DocComment":"     HashMap::with_hasher(BuildHasherDefault::new());"},{"DocComment":" static NONRANDOM_MAP: Mutex<HashMap<String, Vec<i32>, BuildHasherDefault<DefaultHasher>>> ="},{"DocComment":"     Mutex::new(HashMap::with_hasher(BuildHasherDefault::new()));"},{"DocComment":""},{"DocComment":" // HashMaps using LazyLock to retain random seeding"},{"DocComment":" const RANDOM_EMPTY_MAP: LazyLock<HashMap<String, Vec<i32>>> ="},{"DocComment":"     LazyLock::new(HashMap::new);"},{"DocComment":" static RANDOM_MAP: LazyLock<Mutex<HashMap<String, Vec<i32>>>> ="},{"DocComment":"     LazyLock::new(|| Mutex::new(HashMap::new()));"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"HashMap"},"generics":{"regions":[],"types":[{"index":0,"name":"K","variance":"Covariant"},{"index":1,"name":"V","variance":"Covariant"},{"index":2,"name":"S","variance":"Covariant"},{"index":3,"name":"A","variance":"Covariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":246,"col":4},"end":{"line":246,"col":5}},"generated_from_span":null}},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[1,0]}}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":247,"col":4},"end":{"line":247,"col":5}},"generated_from_span":null}},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[1,1]}}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":248,"col":4},"end":{"line":248,"col":19}},"generated_from_span":null}},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Unta