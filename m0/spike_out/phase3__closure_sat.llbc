[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"deallocate","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["alloc",0]},{"Ident":["Allocator",0]},{"Ident":["deallocate",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":274,"col":4},"end":{"line":274,"col":66}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Deallocates the memory referenced by `ptr`."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" * `ptr` must denote a block of memory [*currently allocated*] via this allocator, and"},{"DocComment":" * `layout` must [*fit*] that block of memory."},{"DocComment":""},{"DocComment":" Note that it is *immediate* language UB for a deallocation or reallocation to"},{"DocComment":" invalidate any outstanding references, smart pointers, etc.; thus, notably, an"},{"DocComment":" allocator that has been moved into its own [*currently allocated*] memory may"},{"DocComment":" not have its backing memory be freed, even if the allocator is never used again"},{"DocComment":" afterwards. This is due to the fact that such a deallocation would invalidate the"},{"DocComment":" `&self` reference passed to this method."},{"DocComment":""},{"DocComment":" [*currently allocated*]: #currently-allocated-memory"},{"DocComment":" [*fit*]: #memory-fitting"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Bound":[1,0]}}},"Shared"]}},{"Untagged":{"Adt":{"id":17,"generics":{"regions":[],"types":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}},{"Untagged":{"Adt":{"id":15,"gen