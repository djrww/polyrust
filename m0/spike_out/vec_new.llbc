. The size, when rounded up to"},{"DocComment":" the nearest multiple of `align`, does not overflow `isize` (i.e., the rounded value will always be"},{"DocComment":" less than or equal to `isize::MAX`)."},{"DocComment":""},{"DocComment":" (Note that layouts are *not* required to have non-zero size,"},{"DocComment":" even though `GlobalAlloc` requires that all memory requests"},{"DocComment":" be non-zero in size. A caller must either ensure that conditions"},{"DocComment":" like this are met, use specific allocators with looser"},{"DocComment":" requirements, or use the more lenient `Allocator` interface.)"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"AllocLayout","diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Value":[4,{"Constant":{"Value":[2,[{"Integer":{"Unsigned":["Usize","16"]}},{"Deduplicated":7}]]}}]},"guarantee":null},"align":{"chosen":{"Value":[5,{"Constant":{"Value":[3,[{"Integer":{"Unsigned":["Usize","8"]}},{"Deduplicated":7}]]}}]},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":8},{"guarantee":null,"chosen":0}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":6,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["result",0]},{"Ident":["Result",0]}],"span":{"Untagged":{"data":{"file_id":8,"beg":{"line":558,"col":0},"end":{"line":558,"col":21}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `Result` is a type that represents either success ([`Ok`]) or failure ([`Err`])."},{"DocComment":""},{"DocComment":" See the [module document