references, smart pointers, etc.; thus, notably, an"},{"DocComment":" allocator that has been moved into its own [*currently allocated*] memory may"},{"DocComment":" not have its backing memory be freed, even if the allocator is never used again"},{"DocComment":" afterwards. This is due to the fact that such a deallocation would invalidate the"},{"DocComment":" `&self` reference passed to this method."},{"DocComment":""},{"DocComment":" [*currently allocated*]: #currently-allocated-memory"},{"DocComment":" [*fit*]: #memory-fitting"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Bound":[1,0]}}},"Shared"]}},{"Untagged":{"Adt":{"id":9,"generics":{"regions":[],"types":[{"Untagged":{"Scalar":{"Integer":{"Unsigned":"U8"}}}}],"const_generics":[],"trait_refs":[]},"builtin":null}}},{"Untagged":{"Adt":{"id":7,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}}],"output":{"Untagged":{"Adt":{"id":0,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}}},"default":null},"kind":{"TraitMethod":[2,2]}},null,null,null],"vtable":{"id":6,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}],"trait_impls":[{"def_id":0,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Impl":{"Trait":0}}],"span":{"Untagged":{"data":{"file_id":3,"beg":{"line":544,"col":0},"end":{"line":544,"col":38}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Normal","impl_trait":{"id":2,"generics":{"regions":[],"types":[{"Untagged":{"Adt":{"id":3,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}