t compile time."},{"DocComment":""},{"DocComment":" All type parameters have an implicit bound of `Sized`. The special syntax"},{"DocComment":" `?Sized` can be used to remove this bound if it's not appropriate."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(dead_code)]"},{"DocComment":" struct Foo<T>(T);"},{"DocComment":" struct Bar<T: ?Sized>(T);"},{"DocComment":""},{"DocComment":" // struct FooUse(Foo<[i32]>); // error: Sized is not implemented for [i32]"},{"DocComment":" struct BarUse(Bar<[i32]>); // OK"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The one exception is the implicit `Self` type of a trait. A trait does not"},{"DocComment":" have an implicit `Sized` bound as this is incompatible with [trait object]s"},{"DocComment":" where, by definition, the trait needs to work with all possible implementors,"},{"DocComment":" and thus could be any size."},{"DocComment":""},{"DocComment":" Although Rust will let you bind `Sized` to a trait, you won't"},{"DocComment":" be able to use it to form a trait object later:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # #![allow(unused_variables)]"},{"DocComment":" trait Foo { }"},{"DocComment":" trait Bar: Sized { }"},{"DocComment":""},{"DocComment":" struct Impl;"},{"DocComment":" impl Foo for Impl { }"},{"DocComment":" impl Bar for Impl { }"},{"DocComment":""},{"DocComment":" let x: &dyn Foo = &Impl;    // OK"},{"DocComment":" // let y: &dyn Bar = &Impl; // error: the trait `Bar` cannot be made into an object"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [trait object]: ../../book/ch17-02-trait-objects.html"},{"Builtin":"Fundamental"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Sized","diagnostic_item":null},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":158,"col":17},"end":{"line":158,"col":26}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[1,0]}}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[],"vtable":null},{"def_id":1,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["MetaSized",0]}],"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":175,"col":0},"end":{"line":175,"col":33}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types with a size that can be determined from pointer metadata."},{"Builtin":"Fundamental"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"MetaSized","diagnostic_item":null},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":6,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":2,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["AsRef",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":220,"col":0},"end":{"line":220,"col":52}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to do a cheap reference-to-reference conversion."},{"DocComment":""},{"DocComment":" This trait is similar to [`AsMut`] which is used for converting between mutable references."},{"DocComment":" If you need to do a costly conversion it is better to implement [`From`] with type"},{"DocComment":" `&T` or write a custom function."},{"DocComment":""},{"DocComment":" # Relation to `Borrow`"},{"DocComment":""},{"DocComment":" `AsRef` has the same signature as [`Borrow`], but [`Borrow`] is different in a few aspects:"},{"DocComment":""},{"DocComment":" - Unlike `AsRef`, [`Borrow`] has a blanket impl for any `T`, and can be used to accept either"},{"DocComment":"   a reference or a value. (See also note on `AsRef`'s reflexibility below.)"},{"DocComment":" - [`Borrow`] also requires that [`Hash`], [`Eq`] and [`Ord`] for a borrowed value are"},{"DocComment":"   equivalent to those of the owned value. For this reason, if you want to"},{"DocComment":"   borrow only a single field of a struct you can implement `AsRef`, but not [`Borrow`]."},{"DocComment":""},{"DocComment":" **Note: This trait must not fail**. If the conversion can fail, use a"},{"DocComment":" dedicated method which returns an [`Option<T>`] or a [`Result<T, E>`]."},{"DocComment":""},{"DocComment":" # Generic Implementations"},{"DocComment":""},{"DocComment":" `AsRef` auto-dereferences if the inner type is a reference or a mutable reference"},{"DocComment":" (e.g.: `foo.as_ref()` will work the same if `foo` has type `&mut Foo` or `&&mut Foo`)."},{"DocComment":""},{"DocComment":" Note that due to historic reasons, the above currently does not hold generally for all"},{"DocComment":" [dereferenceable types], e.g. `foo.as_ref()` will *not* work the same as"},{"DocComment":" `Box::new(foo).as_ref()`. Instead, many smart pointers provide an `as_ref` implementation which"},{"DocComment":" simply returns a reference to the [pointed-to value] (but do not perform a cheap"},{"DocComment":" reference-to-reference conversion for that value). However, [`AsRef::as_ref`] should not be"},{"DocComment":" used for the sole purpose of dereferencing; instead ['`Deref` coercion'] can be used:"},{"DocComment":""},{"DocComment":" [dereferenceable types]: core::ops::Deref"},{"DocComment":" [pointed-to value]: core::ops::Deref::Target"},{"DocComment":" ['`Deref` coercion']: core::ops::Deref#deref-coercion"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = Box::new(5i32);"},{"DocComment":" // Avoid this:"},{"DocComment":" // let y: &i32 = x.as_ref();"},{"DocComment":" // Better just write:"},{"DocComment":" let y: &i32 = &x;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Types which implement [`Deref`] should consider implementing `AsRef<T>` as follows:"},{"DocComment":""},{"DocComment":" [`Deref`]: core::ops::Deref"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use core::ops::Deref;"},{"DocComment":" # struct SomeType;"},{"DocComment":" # impl Deref for SomeType {"},{"DocComment":" #     type Target = [u8];"},{"DocComment":" #     fn deref(&self) -> &[u8] {"},{"DocComment":" #         &[]"},{"DocComment":" #     }"},{"DocComment":" # }"},{"DocComment":" impl<T> AsRef<T> for SomeType"},{"DocComment":" where"},{"DocComment":"     T: ?Sized,"},{"DocComment":"     <SomeType as Deref>::Target: AsRef<T>,"},{"DocComment":" {"},{"DocComment":"     fn as_ref(&self) -> &T {"},{"DocComment":"         self.deref().as_ref()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Reflexivity"},{"DocComment":""},{"DocComment":" Ideally, `AsRef` would be reflexive, i.e. there would be an `impl<T: ?Sized> AsRef<T> for T`"},{"DocComment":" with [`as_ref`] simply returning its argument unchanged."},{"DocComment":" Such a blanket implementation is currently *not* provided due to technical restrictions of"},{"DocComment":" Rust's type system (it would be overlapping with another existing blanket implementation for"},{"DocComment":" `&T where T: AsRef<U>` which allows `AsRef` to auto-dereference, see \"Generic Implementations\""},{"DocComment":" above)."},{"DocComment":""},{"DocComment":" [`as_ref`]: AsRef::as_ref"},{"DocComment":""},{"DocComment":" A trivial implementation of `AsRef<T> for T` must be added explicitly for a particular type `T`"},{"DocComment":" where needed or desired. Note, however, that not all types from `std` contain such an"},{"DocComment":" implementation, and those cannot be added by external code due to orphan rules."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" By using trait bounds we can accept arguments of different types as long as they can be"},{"DocComment":" converted to the specified type `T`."},{"DocComment":""},{"DocComment":" For example: By creating a generic function that takes an `AsRef<str>` we express that we"},{"DocComment":" want to accept all references that can be converted to [`&str`] as an argument."},{"DocComment":" Since both [`String`] and [`&str`] implement `AsRef<str>` we can accept both as input argument."},{"DocComment":""},{"DocComment":" [`&str`]: primitive@str"},{"DocComment":" [`Borrow`]: crate::borrow::Borrow"},{"DocComment":" [`Eq`]: crate::cmp::Eq"},{"DocComment":" [`Ord`]: crate::cmp::Ord"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn is_hello<T: AsRef<str>>(s: T) {"},{"DocComment":"    assert_eq!(\"hello\", s.as_ref());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let s = \"hello\";"},{"DocComment":" is_hello(s);"},{"DocComment":""},{"DocComment":" let s = \"hello\".to_string();"},{"DocComment":" is_hello(s);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"AsRef"},"src":"Normal","generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"as_ref","item_meta":{"name":[{"Ident":["