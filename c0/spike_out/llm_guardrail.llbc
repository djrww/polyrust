ble":{"id":7,"generics":{"regions":[],"types":[{"Untagged":{"TraitType":[{"Untagged":{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[1,0]}}}],"const_generics":[],"trait_refs":[]}}}}},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":5,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["str",0]},{"Ident":["pattern",0]},{"Ident":["Searcher",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":213,"col":0},"end":{"line":213,"col":29}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A searcher for a string pattern."},{"DocComment":""},{"DocComment":" This trait provides methods for searching for non-overlapping"},{"DocComment":" matches of a pattern starting from the front (left) of a string."},{"DocComment":""},{"DocComment":" It will be implemented by associated `Searcher`"},{"DocComment":" types of the [`Pattern`] trait."},{"DocComment":""},{"DocComment":" The trait is marked unsafe because the indices returned by the"},{"DocComment":" [`next()`][Searcher::next] methods are required to lie on valid utf8"},{"DocComment":" boundaries in the haystack. This enables consumers of this trait to"},{"DocComment":" slice the haystack without additional runtime checks."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Normal","generics":{"regions":[{"index":0,"name":"'a","variance":"Unknown","mutability":"Unknown"}],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":213,"col":0},"end":{"line":274,"col":1}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[1,0]}}}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"haystack","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["str",0]},{"Ident":["pattern",0]},{"Ident":["Searcher",0]},{"Ident":["haystack",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":217,"col":4},"end":{"line":217,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Getter for the underlying string to be searched in"},{"DocComment":""},{"DocComment":" Will always return the same [`&str`][str]."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Bound":[1,0]}}},"Shared"]}}],"output":{"Untagged":{"Ref":[{"Var":{"Bound":[1,0]}},{"Untagged":{"Adt":{"id":2,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":"Str"}}},"Shared"]}}},"default":null},"kind":{"TraitMethod":[5,0]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"next","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["str",0]},{"Ident":["pattern",0]},{"Ident":["Searcher",0]},{"Ident":["next",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":240,"col":4},"end":{"line":240,"col":37}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the next search step starting from the front."},{"DocComment":""},{"DocComment":" - Returns [`Match(a, b)`][SearchStep::Match] if `haystack[a..b]` matches"},{"DocComment":"   the pattern."},{"DocComment":" - Returns [`Reject(a, b)`][SearchStep::Reject] if `haystack[a..b]` can"},{"DocComment":"   not match the pattern, even partially."},{"DocComment":" - Returns [`Done`][SearchStep::Done] if every byte of the haystack has"},{"DocComment":"   been visited."},{"DocComment":""},{"DocComment":" The stream of [`Match`][SearchStep::Match] and"},{"DocComment":" [`Reject`][SearchStep::Reject] values up to a [`Done`][SearchStep::Done]"},{"DocComment":" will contain index ranges that are adjacent, non-overlapping,"},{"DocComment":" covering the whole haystack, and laying on utf8 boundaries."},{"DocComment":""},{"DocComment":" A [`Match`][SearchStep::Match] result needs to contain the whole matched"},{"DocComment":" pattern, however [`Reject`][SearchStep::Reject] results may be split up"},{"DocComment":" into arbitrary many adjacent fragments. Both ranges may have zero length."},{"DocComment":""},{"DocComment":" As an example, the pattern `\"aaa\"` and the haystack `\"cbaaaaab\"`"},{"DocComment":" might produce the stream"},{"DocComment":" `[Reject(0, 1), Reject(1, 2), Match(2, 5), Reject(5, 8)]`"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Untagged":{"Ref":[{"Var":{"Bound":[0,0]}},{"Untagged":{"TypeVar":{"Bound":[1,0]}}},"Mut"]}}],"output":{"Untagged":{"Adt":{"id":9,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}}},"default":null},"kind":{"TraitMethod":[5,1]}},null,null],"vtable":{"id":8,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":6,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["str",0]},{"Ident":["pattern",0]},{"Ident":["ReverseSearcher",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":290,"col":0},"end":{"line":290,"col":50}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A reverse searcher for a string pattern."},{"DocComment":""},{"DocComment":" This trait provides methods for searching for non-overlapping"},{"DocComment":" matches of a pattern starting from the back (right) of a string."},{"DocComment":""},{"DocComment":" It will be implemented by associated [`Searcher`]"},{"DocComment":" types of the [`Pattern`] trait if the pattern supports searching"},{"DocComment":" for it from the back."},{"DocComment":""},{"DocComment":" The index ranges returned by this trait are not required"},{"DocComment":" to exactly match those of the forward search in reverse."},{"DocComment":""},{"DocComment":" For the reason why this trait is marked unsafe, see the"},{"DocComment":" parent trait [`Searcher`]."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Normal","generics":{"regions":[{"index":0,"name":"'a","variance":"Unknown","mutability":"Unknown"}],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":290,"col":0},"end":{"line":339,"col":1}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[1,0]}}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":290,"col":38},"end":{"line":290,"col":50}},"generated_from_span":null}},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[{"Var":{"Bound":[1,0]}}],"types":[{"Untagged":{"TypeVar":{"Bound":[1,0]}}}]