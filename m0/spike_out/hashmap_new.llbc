otal_eq","assert_fields_are_eq"],"consts":[]},{"types":[],"methods":["hash","hash_slice"],"consts":[]},{"types":["Hasher"],"methods":["build_hasher","hash_one"],"consts":[]},{"types":[],"methods":["to_string"],"consts":[]},{"types":[],"methods":["eq","ne"],"consts":[]},{"types":[],"methods":["finish","write","write_u8","write_u16","write_u32","write_u64","write_u128","write_usize","write_i8","write_i16","write_i32","write_i64","write_i128","write_isize","write_length_prefix","write_str"],"consts":[]}],"short_names":[{"key":{"TraitImpl":0},"value":[{"Ident":["impl_Allocator_for_Global",0]}]},{"key":{"TraitImpl":1},"value":[{"Ident":["impl_ToString_for_T",0]}]},{"key":{"Fun":2},"value":[{"Ident":["to_string",0]}]},{"key":{"TraitImpl":2},"value":[{"Ident":["impl_Display_for_str",0]}]},{"key":{"TraitImpl":3},"value":[{"Ident":["impl_Destruct_for_HashMap",0]}]},{"key":{"TraitImpl":4},"value":[{"Ident":["impl_Eq_for_String",0]}]},{"key":{"TraitImpl":5},"value":[{"Ident":["impl_Hash_for_String",0]}]},{"key":{"TraitImpl":6},"value":[{"Ident":["impl_BuildHasher_for_RandomState",0]}]},{"key":{"TraitImpl":7},"value":[{"Ident":["impl_Destruct_for_String",0]}]},{"key":{"Global":1},"value":[{"Impl":{"Trait":0}},{"Builtin":["VTable",0]}]},{"key":{"Fun":8},"value":[{"Ident":["allocate",0]}]},{"key":{"Fun":9},"value":[{"Impl":{"Trait":0}},{"Ident":["allocate_zeroed",0]}]},{"key":{"Fun":10},"value":[{"Ident":["deallocate",0]}]},{"key":{"Fun":11},"value":[{"Impl":{"Trait":0}},{"Ident":["grow",0]}]},{"key":{"Fun":12},"value":[{"Impl":{"Trait":0}},{"Ident":["grow_zeroed",0]}]},{"key":{"Fun":13},"value":[{"Impl":{"Trait":0}},{"Ident":["shrink",0]}]},{"key":{"Global":2},"value":[{"Impl":{"Trait":1}},{"Builtin":["VTable",0]}]},{"key":{"Global":3},"value":[{"Impl":{"Trait":2}},{"Builtin":["VTable",0]}]},{"key":{"Fun":14},"value":[{"Ident":["fmt",0]}]},{"key":{"Fun":15},"value":[{"Impl":{"Trait":3}},{"Builtin":["DropGlue",0]}]},{"key":{"TraitImpl":8},"value":[{"Ident":["impl_PartialEq_String_for_String",0]}]},{"key":{"Fun":20},"value":[{"Impl":{"Trait":4}},{"Ident":["assert_fields_are_eq",0]}]},{"key":{"Fun":21},"value":[{"Ident":["hash",0]}]},{"key":{"Global":4},"value":[{"Impl":{"Trait":6}},{"Builtin":["VTable",0]}]},{"key":{"TraitImpl":9},"value":[{"Ident":["impl_Hasher_for_DefaultHasher",0]}]},{"key":{"Fun":22},"value":[{"Ident":["build_hasher",0]}]},{"key":{"Fun":23},"value":[{"Impl":{"Trait":7}},{"Builtin":["DropGlue",0]}]},{"key":{"Global":5},"value":[{"Impl":{"Trait":8}},{"Builtin":["VTable",0]}]},{"key":{"Fun":39},"value":[{"Ident":["eq",0]}]},{"key":{"Global":6},"value":[{"Impl":{"Trait":9}},{"Builtin":["VTable",0]}]},{"key":{"Fun":40},"value":[{"Ident":["finish",0]}]},{"key":{"Fun":41},"value":[{"Ident":["write",0]}]},{"key":{"Fun":42},"value":[{"Impl":{"Trait":9}},{"Ident":["write_str",0]}]},{"key":{"Type":5},"value":[{"Ident":["Option",0]}]},{"key":{"TraitDecl":5},"value":[{"Ident":["Eq",0]}]},{"key":{"Type":3},"value":[{"Ident":["RandomState",0]}]},{"key":{"Fun":37},"value":[{"Ident":["write_length_prefix",0]}]},{"key":{"Fun":31},"value":[{"Ident":["write_i8",0]}]},{"key":{"Fun":33},"value":[{"Ident":["write_i32",0]}]},{"key":{"Type":2},"value":[{"Ident":["String",0]}]},{"key":{"Type":10},"value":[{"Ident":["Result",0]}]},{"key":{"Fun":34},"value":[{"Ident":["write_i64",0]}]},{"key":{"TraitDecl":4},"value":[{"Ident":["Destruct",0]}]},{"key":{"Fun":36},"value":[{"Ident":["write_isize",0]}]},{"key":{"Type":12},"value":[{"Ident":["AllocError",0]}]},{"key":{"TraitDecl":8},"value":[{"Ident":["ToString",0]}]},{"key":{"TraitDecl":6},"value":[{"Ident":["Hash",0]}]},{"key":{"Type":14},"value":[{"Ident":["Formatter",0]}]},{"key":{"TraitDecl":0},"value":[{"Ident":["Sized",0]}]},{"key":{"TraitDecl":2},"value":[{"Ident":["Allocator",0]}]},{"key":{"TraitDecl":3},"value":[{"Ident":["Display",0]}]},{"key":{"Fun":18},"value":[{"Ident":["hash_slice",0]}]},{"key":{"Fun":29},"value":[{"Ident":["write_u128",0]}]},{"key":{"Fun":16},"value":[{"Ident":["assert_receiver_is_total_eq",0]}]},{"key":{"Fun":32},"value":[{"Ident":["write_i16",0]}]},{"key":{"Fun":25},"value":[{"Ident":["write_u8",0]}]},{"key":{"Fun":28},"value":[{"Ident":["write_u64",0]}]},{"key":{"Type":11},"value":[{"Ident":["NonNull",0]}]},{"key":{"Fun":27},"value":[{"Ident":["write_u32",0]}]},{"key":{"TraitDecl":1},"value":[{"Ident":["MetaSized",0]}]},{"key":{"Type":4},"value":[{"Ident":["Global",0]}]},{"key":{"Type":9},"value":[{"Ident":["Layout",0]}]},{"key":{"Type":17},"value":[{"Ident":["DefaultHasher",0]}]},{"key":{"Fun":1},"value":[{"Ident":["new",0]}]},{"key":{"TraitDecl":9},"value":[{"Ident":["PartialEq",0]}]},{"key":{"Fun":26},"value":[{"Ident":["write_u16",0]}]},{"key":{"Fun":3},"value":[{"Ident":["insert",0]}]},{"key":{"Fun":24},"value":[{"Ident":["ne",0]}]},{"key":{"Fun":30},"value":[{"Ident":["write_usize",0]}]},{"key":{"Type":15},"value":[{"Ident":["Error",0]}]},{"key":{"TraitDecl":10},"value":[{"Ident":["Hasher",0]}]},{"key":{"Fun":0},"value":[{"Ident":["make_map",0]}]},{"key":{"Type":1},"value":[{"Ident":["HashMap",0]}]},{"key":{"Fun":35},"value":[{"Ident":["write_i128",0]}]},{"key":{"TraitDecl":7},"value":[{"Ident":["BuildHasher",0]}]},{"key":{"Fun":19},"value":[{"Ident":["hash_one",0]}]}],"type_decls":[{"def_id":0,"item_meta":{"name":[{"Builtin":[{"Tuple":0},0]}],"span":{"Untagged":{"data":{"file_id":0,"beg":{"line":1,"col":0},"end":{"line":1,"col":0}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":{"Builtin":"Tuple"},"kind":{"Struct":[]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","0"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":{"Untagged":{"AtLeast":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","0"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}}}}},"align":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","1"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":{"Untagged":{"AtLeast":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","1"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}}}}},"discriminator":{"Known":0},"inhabited":{"Untagged":"True"},"variant_layouts":[{"field_offsets":[],"inhabited":{"Untagged":"True"},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":1,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["collections",0]},{"Ident":["hash",0]},{"Ident":["map",0]},{"Ident":["HashMap",0]}],"span":{"Untagged":{"data":{"file_id":1,"beg":{"line":245,"col":0},"end":{"line":250,"col":1}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A [hash map] implemented with quadratic probing and SIMD lookup."},{"DocComment":""},{"DocComment":" By default, `HashMap` uses a hashing algorithm selected to provide"},{"DocComment":" resistance against HashDoS attacks. The algorithm is randomly seeded, and a"},{"DocComment":" reasonable best-effort is made to generate this seed from a high quality,"},{"DocComment":" secure source of randomness provided by the host without blocking the"},{"DocComment":" program. Because of this, the randomness of the seed depends on the output"},{"DocComment":" quality of the system's random number generator when the seed is created."},{"DocComment":" In particular, seeds generated when the system's entropy pool is abnormally"},{"DocComment":" low such as during system boot may be of a lower quality."},{"DocComment":""},{"DocComment":" The default hashing algorithm is currently SipHash 1-3, though this is"},{"DocComment":" subject to change at any point in the future. While its performance is very"},{"DocComment":" competitive for medium sized keys, other hashing algorithms will outperform"},{"DocComment":" it for small keys such as integers as well as large keys such as long"},{"DocComment":" strings, though those algorithms will typically *not* protect against"},{"DocComment":" attacks such as HashDoS."},{"DocComment":""},{"DocComment":" The hashing algorithm can be replaced on a per-`HashMap` basis using the"},{"DocComment":" [`default`], [`with_hasher`], and [`with_capacity_and_hasher`] methods."},{"DocComment":" There are many alternative [hashing algorithms available on crates.io]."},{"DocComment":""},{"DocComment":" It is required that the keys implement the [`Eq`] and [`Hash`] traits, although"},{"DocComment":" this can frequently be achieved by using `#[derive(PartialEq, Eq, Hash)]`."},{"DocComment":" If you implement these yourself, it is important that the following"},{"DocComment":" property holds:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" k1 == k2 -> hash(k1) == hash(k2)"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In other words, if two keys are equal, their hashes must be equal."},{"DocComment":" Violating this property is a logic error."},{"DocComment":""},{"DocComment":" It is also a logic error for a key to be modified in such a way that the key's"},{"DocComment":" hash, as determined by the [`Hash`] trait, or its equality, as determined by"},{"DocComment":" the [`Eq`] trait, changes while it is in the map. This is normally only"},{"DocComment":" possible through [`Cell`], [`RefCell`], global state, I/O, or unsafe code."},{"DocComment":""},{"DocComment":" The behavior resulting from either logic error is not specified, but will"},{"DocComment":" be encapsulated to the `HashMap` that observed the logic error and not"},{"DocComment":" result in undefined behavior. This could include panics, incorrect results,"},{"DocComment":" aborts, memory leaks, and non-termination."},{"DocComment":""},{"DocComment":" The hash table implementation is a Rust port of Google's [SwissTable]."},{"DocComment":" The original C++ version of SwissTable can be found [here], and this"},{"DocComment":" [CppCon talk] gives an overview of how the algorithm works."},{"DocComment":""},{"DocComment":" [hash map]: crate::collections#use-a-hashmap-when"},{"DocComment":" [hashing algorithms available on crates.io]: https://crates.io/keywords/hasher"},{"DocComment":" [SwissTable]: https://abseil.io/blog/20180927-swisstables"},{"DocComment":" [here]: https://github.com/abseil/abseil-cpp/blob/master/absl/container/internal/raw_hash_set.h"},{"DocComment":" [CppCon talk]: https://www.youtube.com/watch?v=ncHmEUmJZf4"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" // Type inference lets us omit an explicit type signature (which"},{"DocComment":" // would be `HashMap<String, String>` in this example)."},{"DocComment":" let mut book_reviews = HashMap::new();"},{"DocComment":""},{"DocComment":" // Review some books."},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"Adventures of Huckleberry Finn\".to_string(),"},{"DocComment":"     \"My favorite book.\".to_string(),"},{"DocComment":" );"},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"Grimms' Fairy Tales\".to_string(),"},{"DocComment":"     \"Masterpiece.\".to_string(),"},{"DocComment":" );"},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"Pride and Prejudice\".to_string(),"},{"DocComment":"     \"Very enjoyable.\".to_string(),"},{"DocComment":" );"},{"DocComment":" book_reviews.insert("},{"DocComment":"     \"The Adventures of Sherlock Holmes\".to_string(),"},{"DocComment":"     \"Eye lyked it alot.\".to_string(),"},{"DocComment":" );"},{"DocComment":""},{"DocComment":" // Check for a specific one."},{"DocComment":" // When collections store owned values (String), they can still be"},{"DocComment":" // queried using references (&str)."},{"DocComment":" if !book_reviews.contains_key(\"Les Misérables\") {"},{"DocComment":"     println!(\"We've got {} reviews, but Les Misérables ain't one.\","},{"DocComment":"              book_reviews.len());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // oops, this review has a lot of spelling mistakes, let's delete it."},{"DocComment":" book_reviews.remove(\"The Adventures of Sherlock Holmes\");"},{"DocComment":""},{"DocComment":" // Look up the values associated with some keys."},{"DocComment":" let to_find = [\"Pride and Prejudice\", \"Alice's Adventure in Wonderland\"];"},{"DocComment":" for &book in &to_find {"},{"DocComment":"     match book_reviews.get(book) {"},{"DocComment":"         Some(review) => println!(\"{book}: {review}\"),"},{"DocComment":"         None => println!(\"{book} is unreviewed.\")"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Look up the value for a key (will panic if the key is not found)."},{"DocComment":" println!(\"Review for Jane: {}\", book_reviews[\"Pride and Prejudice\"]);"},{"DocComment":""},{"DocComment":" // Iterate over everything."},{"DocComment":" for (book, review) in &book_reviews {"},{"DocComment":"     println!(\"{book}: \\\"{review}\\\"\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A `HashMap` with a known list of items can be initialized from an array:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" let solar_distance = HashMap::from(["},{"DocComment":"     (\"Mercury\", 0.4),"},{"DocComment":"     (\"Venus\", 0.7),"},{"DocComment":"     (\"Earth\", 1.0),"},{"DocComment":"     (\"Mars\", 1.5),"},{"DocComment":" ]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## `Entry` API"},{"DocComment":""},{"DocComment":" `HashMap` implements an [`Entry` API](#method.entry), which allows"},{"DocComment":" for complex methods of getting, setting, updating and removing keys and"},{"DocComment":" their values:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" // type inference lets us omit an explicit type signature (which"},{"DocComment":" // would be `HashMap<&str, u8>` in this example)."},{"DocComment":" let mut player_stats = HashMap::new();"},{"DocComment":""},{"DocComment":" fn random_stat_buff() -> u8 {"},{"DocComment":"     // could actually return some random value here - let's just return"},{"DocComment":"     // some fixed value for now"},{"DocComment":"     42"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // insert a key only if it doesn't already exist"},{"DocComment":" player_stats.entry(\"health\").or_insert(100);"},{"DocComment":""},{"DocComment":" // insert a key using a function that provides a new value only if it"},{"DocComment":" // doesn't already exist"},{"DocComment":" player_stats.entry(\"defence\").or_insert_with(random_stat_buff);"},{"DocComment":""},{"DocComment":" // update a key, guarding against the key possibly not being set"},{"DocComment":" let stat = player_stats.entry(\"attack\").or_insert(100);"},{"DocComment":" *stat += random_stat_buff();"},{"DocComment":""},{"DocComment":" // modify an entry before an insert with in-place mutation"},{"DocComment":" player_stats.entry(\"mana\").and_modify(|mana| *mana += 200).or_insert(100);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Usage with custom key types"},{"DocComment":""},{"DocComment":" The easiest way to use `HashMap` with a custom key type is to derive [`Eq`] and [`Hash`]."},{"DocComment":" We must also derive [`PartialEq`]."},{"DocComment":""},{"DocComment":" [`RefCell`]: crate::cell::RefCell"},{"DocComment":" [`Cell`]: crate::cell::Cell"},{"DocComment":" [`default`]: Default::default"},{"DocComment":" [`with_hasher`]: Self::with_hasher"},{"DocComment":" [`with_capacity_and_hasher`]: Self::with_capacity_and_hasher"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":""},{"DocComment":" #[derive(Hash, Eq, PartialEq, Debug)]"},{"DocComment":" struct Viking {"},{"DocComment":"     name: String,"},{"DocComment":"     country: String,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Viking {"},{"DocComment":"     /// Creates a new Viking."},{"DocComment":"     fn new(name: &str, country: &str) -> Viking {"},{"DocComment":"         Viking { name: name.to_string(), country: country.to_string() }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Use a HashMap to store the vikings' health points."},{"DocComment":" let vikings = HashMap::from(["},{"DocComment":"     (Viking::new(\"Einar\", \"Norway\"), 25),"},{"DocComment":"     (Viking::new(\"Olaf\", \"Denmark\"), 24),"},{"DocComment":"     (Viking::new(\"Harald\", \"Iceland\"), 12),"},{"DocComment":" ]);"},{"DocComment":""},{"DocComment":" // Use derived implementation to print the status of the vikings."},{"DocComment":" for (viking, health) in &vikings {"},{"DocComment":"     println!(\"{viking:?} has {health} hp\");"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Usage in `const` and `static`"},{"DocComment":""},{"DocComment":" As explained above, `HashMap` is randomly seeded: each `HashMap` instance uses a different seed,"},{"DocComment":" which means that `HashMap::new` normally cannot be used in a `const` or `static` initializer."},{"DocComment":""},{"DocComment":" However, if you need to use a `HashMap` in a `const` or `static` initializer while retaining"},{"DocComment":" random seed generation, you can wrap the `HashMap` in [`LazyLock`]."},{"DocComment":""},{"DocComment":" Alternatively, you can construct a `HashMap` in a `const` or `static` initializer using a different"},{"DocComment":" hasher that does not rely on a random seed. **Be aware that a `HashMap` created this way is not"},{"DocComment":" resistant to HashDoS attacks!**"},{"DocComment":""},{"DocComment":" [`LazyLock`]: crate::sync::LazyLock"},{"DocComment":" ```rust"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":" use std::hash::{BuildHasherDefault, DefaultHasher};"},{"DocComment":" use std::sync::{LazyLock, Mutex};"},{"DocComment":""},{"DocComment":" // HashMaps with a fixed, non-random hasher"},{"DocComment":" const NONRANDOM_EMPTY_MAP: HashMap<String, Vec<i32>, BuildHasherDefault<DefaultHasher>> ="},{"DocComment":"     HashMap::with_hasher(BuildHasherDefault::new());"},{"DocComment":" static NONRANDOM_MAP: Mutex<HashMap<String, Vec<i32>, BuildHasherDefault<DefaultHasher>>> ="},{"DocComment":"     Mutex::new(HashMap::with_hasher(BuildHasherDefault::new()));"},{"DocComment":""},{"DocComment":" // HashMaps using LazyLock to retain random seeding"},{"DocComment":" const RANDOM_EMPTY_MAP: LazyLock<HashMap<String, Vec<i32>>> ="},{"DocComment":"     LazyLock::new(HashMap::new);"},{"DocComment":" static RANDOM_MAP: LazyLock<Mutex<HashMap<String, Vec<i32>>>> ="},{"DocComment":"     LazyLock::new(|| Mutex::new(HashMap::new()));"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"HashMap"},"generics":{"regions":[],"types":[{"index":0,"name":"K","variance":"Covariant"},{"index":1,"name":"V","variance":"Covariant"},{"index":2,"name":"S","variance":"Covariant"},{"index":3,"name":"A","variance":"Covariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Untagged":{"data":{"file_id":1,"beg":{"line":246,"col":4},"end":{"line":246,"col":5}},"generated_from_span":null}},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[1,0]}}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Untagged":{"data":{"file_id":1,"beg":{"line":247,"col":4},"end":{"line":247,"col":5}},"generated_from_span":null}},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[1,1]}}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"Untagged":{"data":{"file_id":1,"beg":{"line":248,"col":4},"end":{"line":248,"col":19}},"generated_from_span":null}},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[1,2]}}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"Untagged":{"data":{"file_id":1,"beg":{"line":249,"col":60},"end":{"line":249,"col":81}},"generated_from_span":null}},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":0,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[1,3]}}}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":4,"span":{"Untagged":{"data":{"file_id":1,"beg":{"line":249,"col":63},"end":{"line":249,"col":72}},"generated_from_span":null}},"origin":"WhereClauseOnType","trait_":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Untagged":{"TypeVar":{"Bound":[1,3]}}}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":2,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["string",0]},{"Ident":["String",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":353,"col":0},"end":{"line":353,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A UTF-8–encoded, growable string."},{"DocComment":""},{"DocComment":" `String` is the most common string type. It has ownership over the contents"},{"DocComment":" of the string, stored in a heap-allocated buffer (see [Representation](#representation))."},{"DocComment":" It is closely related to its borrowed counterpart, the primitive [`str`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" You can create a `String` from [a literal string][`&str`] with [`String::from`]:"},{"DocComment":""},{"DocComment":" [`String::from`]: From::from"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let hello = String::from(\"Hello, world!\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" You can append a [`char`] to a `String` with the [`push`] method, and"},{"DocComment":" append a [`&str`] with the [`push_str`] method:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut hello = String::from(\"Hello, \");"},{"DocComment":""},{"DocComment":" hello.push('w');"},{"DocComment":" hello.push_str(\"orld!\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`push`]: String::push"},{"DocComment":" [`push_str`]: String::push_str"},{"DocComment":""},{"DocComment":" If you have a vector of UTF-8 bytes, you can create a `String` from it with"},{"DocComment":" the [`from_utf8`] method:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // some bytes, in a vector"},{"DocComment":" let sparkle_heart = vec![240, 159, 146, 150];"},{"DocComment":""},{"DocComment":" // We know these bytes are valid, so we'll use `unwrap()`."},{"DocComment":" let sparkle_heart = String::from_utf8(sparkle_heart).unwrap();"},{"DocComment":""},{"DocComment":" assert_eq!(\"💖\", sparkle_heart);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`from_utf8`]: String::from_utf8"},{"DocComment":""},{"DocComment":" # UTF-8"},{"DocComment":""},{"DocComment":" `String`s are always valid UTF-8. If you need a non-UTF-8 string, consider"},{"DocComment":" [`OsString`]. It is similar, but without the UTF-8 constraint. Because UTF-8"},{"DocComment":" is a variable width encoding, `String`s are typically smaller than an array of"},{"DocComment":" the same `char`s:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // `s` is ASCII which represents each `char` as one byte"},{"DocComment":" let s = \"hello\";"},{"DocComment":" assert_eq!(s.len(), 5);"},{"DocComment":""},{"DocComment":" // A `char` array with the same contents would be longer because"},{"DocComment":" // every `char` is four bytes"},{"DocComment":" let s = ['h', 'e', 'l', 'l', 'o'];"},{"DocComment":" let size: usize = s.into_iter().map(|c| size_of_val(&c)).sum();"},{"DocComment":" assert_eq!(size, 20);"},{"DocComment":""},{"DocComment":" // However, for non-ASCII strings, the difference will be smaller"},{"DocComment":" // and sometimes they are the same"},{"DocComment":" let s = \"💖💖💖💖💖\";"},{"DocComment":" assert_eq!(s.len(), 20);"},{"DocComment":""},{"DocComment":" let s = ['💖', '💖', '💖', '💖', '💖'];"},{"DocComment":" let size: usize = s.into_iter().map(|c| size_of_val(&c)).sum();"},{"DocComment":" assert_eq!(size, 20);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This raises interesting questions as to how `s[i]` should work."},{"DocComment":" What should `i` be here? Several options include byte indices and"},{"DocComment":" `char` indices but, because of UTF-8 encoding, only byte indices"},{"DocComment":" would provide constant time indexing. Getting the `i`th `char`, for"},{"DocComment":" example, is available using [`chars`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s = \"hello\";"},{"DocComment":" let third_character = s.chars().nth(2);"},{"DocComment":" assert_eq!(third_character, Some('l'));"},{"DocComment":""},{"DocComment":" let s = \"💖💖💖💖💖\";"},{"DocComment":" let third_character = s.chars().nth(2);"},{"DocComment":" assert_eq!(third_character, Some('💖'));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Next, what should `s[i]` return? Because indexing returns a reference"},{"DocComment":" to underlying data it could be `&u8`, `&[u8]`, or something similar."},{"DocComment":" Since we're only providing one index, `&u8` makes the most sense but that"},{"DocComment":" might not be what the user expects and can be explicitly achieved with"},{"DocComment":" [`as_bytes()`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // The first byte is 104 - the byte value of `'h'`"},{"DocComment":" let s = \"hello\";"},{"DocComment":" assert_eq!(s.as_bytes()[0], 104);"},{"DocComment":" // or"},{"DocComment":" assert_eq!(s.as_bytes()[0], b'h');"},{"DocComment":""},{"DocComment":" // The first byte is 240 which isn't obviously useful"},{"DocComment":" let s = \"💖💖💖💖💖\";"},{"DocComment":" assert_eq!(s.as_bytes()[0], 240);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Due to these ambiguities/restrictions, indexing with a `usize` is simply"},{"DocComment":" forbidden:"},{"DocComment":""},{"DocComment":" ```compile_fail,E0277"},{"DocComment":" let s = \"hello\";"},{"DocComment":""},{"DocComment":" // The following will not compile!"},{"DocComment":" println!(\"The first letter of s is {}\", s[0]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" It is more clear, however, how `&s[i..j]` should work (that is,"},{"DocComment":" indexing with a range). It should accept byte indices (to be constant-time)"},{"DocComment":" and return a `&str` which is UTF-8 encoded. This is also called \"string slicing\"."},{"DocComment":" Note this will panic if the byte indices provided are not character"},{"DocComment":" boundaries - see [`is_char_boundary`] for more details. See the implementations"},{"DocComment":" for [`SliceIndex<str>`] for more details on string slicing. For a non-panicking"},{"DocComment":" version of string slicing, see [`get`]."},{"DocComment":""},{"DocComment":" [`OsString`]: ../../std/ffi/struct.OsString.html \"ffi::OsString\""},{"DocComment":" [`SliceIndex<str>`]: core::slice::SliceIndex"},{"DocComment":" [`as_bytes()`]: str::as_bytes"},{"DocComment":" [`get`]: str::get"},{"DocComment":" [`is_char_boundary`]: str::is_char_boundary"},{"DocComment":""},{"DocComment":" The [`bytes`] and [`chars`] methods return iterators over the bytes and"},{"DocComment":" codepoints of the string, respectively. To iterate over codepoints along"},{"DocComment":" with byte indices, use [`char_indices`]."},{"DocComment":""},{"DocComment":" [`bytes`]: str::bytes"},{"DocComment":" [`chars`]: str::chars"},{"DocComment":" [`char_indices`]: str::char_indices"},{"DocComment":""},{"DocComment":" # Deref"},{"DocComment":""},{"DocComment":" `String` implements <code>[Deref]<Target = [str]></code>, and so inherits all of [`str`]'s"},{"DocComment":" methods. In addition, this means that you can pass a `String` to a"},{"DocComment":" function which takes a [`&str`] by using an ampersand (`&`):"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn takes_str(s: &str) { }"},{"DocComment":""},{"DocComment":" let s = String::from(\"Hello\");"},{"DocComment":""},{"DocComment":" takes_str(&s);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will create a [`&str`] from the `String` and pass it in. This"},{"DocComment":" conversion is very inexpensive, and so generally, functions will accept"},{"DocComment":" [`&str`]s as arguments unless they need a `String` for some specific"},{"DocComment":" reason."},{"DocComment":""},{"DocComment":" In certain cases Rust doesn't have enough information to make this"},{"DocComment":" conversion, known as [`Deref`] coercion. In the following example a string"},{"DocComment":" slice [`&'a str`][`&str`] implements the trait `TraitExample`, and the function"},{"DocComment":" `example_func` takes anything that implements the trait. In this case Rust"},{"DocComment":" would need to make two implicit conversions, which Rust doesn't have the"},{"DocComment":" means to do. For that reason, the following example will not compile."},{"DocComment":""},{"DocComment":" ```compile_fail,E0277"},{"DocComment":" trait TraitExample {}"},{"DocComment":""},{"DocComment":" impl<'a> TraitExample for &'a str {}"},{"DocComment":""},{"DocComment":" fn example_func<A: TraitExample>(example_arg: A) {}"},{"DocComment":""},{"DocComment":" let example_string = String::from(\"example_string\");"},{"DocComment":" example_func(&example_string);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There are two options that would work instead. The first would be to"},{"DocComment":" change the line `example_func(&example_string);` to"},{"DocComment":" `example_func(example_string.as_str());`, using the method [`as_str()`]"},{"DocComment":" to explicitly extract the string slice containing the string. The second"},{"DocComment":" way changes `example_func(&example_string);` to"},{"DocComment":" `example_func(&*example_string);`. In this case we are dereferencing a"},{"DocComment":" `String` to a [`str`], then referencing the [`str`] back to"},{"DocComment":" [`&str`]. The second way is more idiomatic, however both work to do the"},{"DocComment":" conversion explicitly rather than relying on the implicit conversion."},{"DocComment":""},{"DocComment":" # Representation"},{"DocComment":""},{"DocComment":" A `String` is made up of three components: a pointer to some bytes, a"},{"DocComment":" length, and a capacity. The pointer points to the internal buffer which `String`"},{"DocComment":" uses to store its data. The length is the number of bytes currently stored"},{"DocComment":" in the buffer, and the capacity is the size of the buffer in bytes. As such,"},{"DocComment":" the length will always be less than or equal to the capacity."},{"DocComment":""},{"DocComment":" This buffer is always stored on the heap."},{"DocComment":""},{"DocComment":" You can look at these with the [`as_ptr`], [`len`], and [`capacity`]"},{"DocComment":" methods:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let story = String::from(\"Once upon a time...\");"},{"DocComment":""},{"DocComment":" // Deconstruct the String into parts."},{"DocComment":" let (ptr, len, capacity) = story.into_raw_parts();"},{"DocComment":""},{"DocComment":" // story has nineteen bytes"},{"DocComment":" assert_eq!(19, len);"},{"DocComment":""},{"DocComment":" // We can re-build a String out of ptr, len, and capacity. This is all"},{"DocComment":" // unsafe because we are responsible for making sure the components are"},{"DocComment":" // valid:"},{"DocComment":" let s = unsafe { String::from_raw_parts(ptr, len, capacity) } ;"},{"DocComment":""},{"DocComment":" assert_eq!(String::from(\"Once upon a time...\"), s);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`as_ptr`]: str::as_ptr"},{"DocComment":" [`len`]: String::len"},{"DocComment":" [`capacity`]: String::capacity"},{"DocComment":""},{"DocComment":" If a `String` has enough capacity, adding elements to it will not"},{"DocComment":" re-allocate. For example, consider this program:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut s = String::new();"},{"DocComment":""},{"DocComment":" println!(\"{}\", s.capacity());"},{"DocComment":""},{"DocComment":" for _ in 0..5 {"},{"DocComment":"     s.push_str(\"hello\");"},{"DocComment":"     println!(\"{}\", s.capacity());"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This will output the following:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" 0"},{"DocComment":" 8"},{"DocComment":" 16"},{"DocComment":" 16"},{"DocComment":" 32"},{"DocComment":" 32"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" At first, we have no memory allocated at all, but as we append to the"},{"DocComment":" string, it increases its capacity appropriately. If we instead use the"},{"DocComment":" [`with_capacity`] method to allocate the correct capacity initially:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut s = String::with_capacity(25);"},{"DocComment":""},{"DocComment":" println!(\"{}\", s.capacity());"},{"DocComment":""},{"DocComment":" for _ in 0..5 {"},{"DocComment":"     s.push_str(\"hello\");"},{"DocComment":"     println!(\"{}\", s.capacity());"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`with_capacity`]: String::with_capacity"},{"DocComment":""},{"DocComment":" We end up with a different output:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" 25"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Here, there's no need to allocate more memory inside the loop."},{"DocComment":""},{"DocComment":" [str]: prim@str \"str\""},{"DocComment":" [`str`]: prim@str \"str\""},{"DocComment":" [`&str`]: prim@str \"&str\""},{"DocComment":" [Deref]: core::ops::Deref \"ops::Deref\""},{"DocComment":" [`Deref`]: core::ops::Deref \"ops::Deref\""},{"DocComment":" [`as_str()`]: String::as_str"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"String","diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","24"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":null},"align":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","8"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Untagged":"True"},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0}],"inhabited":{"Untagged":"True"},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":3,"item_meta":{"name":[{"Ident":["std",0]},{"Ident":["hash",0]},{"Ident":["random",0]},{"Ident":["RandomState",0]}],"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":35,"col":0},"end":{"line":35,"col":22}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `RandomState` is the default state for [`HashMap`] types."},{"DocComment":""},{"DocComment":" A particular instance `RandomState` will create the same instances of"},{"DocComment":" [`Hasher`], but the hashers created by two different `RandomState`"},{"DocComment":" instances are unlikely to produce the same result for the same values."},{"DocComment":""},{"DocComment":" [`HashMap`]: crate::collections::HashMap"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::collections::HashMap;"},{"DocComment":" use std::hash::RandomState;"},{"DocComment":""},{"DocComment":" let s = RandomState::new();"},{"DocComment":" let mut map = HashMap::with_hasher(s);"},{"DocComment":" map.insert(1, 2);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","16"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":null},"align":{"chosen":{"Untagged":{"Constant":{"Untagged":[{"Integer":{"Unsigned":["Usize","8"]}},{"Untagged":{"Scalar":{"Integer":{"Unsigned":"Usize"}}}}]}}},"guarantee":null},"discriminator":{"Known":0},"inhabited":{"Untagged":"True"},"variant_layouts":[{"field_offsets":[{"guarantee":null,"chosen":0},{"guarantee":null,"chosen":8}],"inhabited":{"Untagged":"True"},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None"},{"def_id":4,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["alloc",0]},{"Ident":["Global",0]}],"s