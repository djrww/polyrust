,"col":4},"end":{"line":91,"col":43}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the `+` operation."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!(12 + 1, 13);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"add"},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":14},{"Deduplicated":20}],"output":{"Deduplicated":21}},"default":null},"kind":{"TraitMethod":[4,0]}}],"vtable":{"id":5,"generics":{"regions":[],"types":[{"Value":[23,{"TypeVar":{"Bound":[0,1]}}]},{"Value":[24,{"TraitType":[{"Value":[5,{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":14},{"Deduplicated":20}],"const_generics":[],"trait_refs":[]}}}}]},0,{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}]}]}],"const_generics":[],"trait_refs":[]},"builtin":null}}],"trait_impls":[{"def_id":0,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["string",0]},{"Impl":{"Trait":0}}],"span":{"Untagged":{"data":{"file_id":1,"beg":{"line":2892,"col":0},"end":{"line":2892,"col":26}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Normal","impl_trait":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":3}],"const_generics":[],"trait_refs":[]}},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[{"Value":[6,{"kind":{"BuiltinOrAuto":{"builtin_data":"MetaSized","parent_trait_refs":[],"types":[],"vtable":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":5}],"const_generics":[],"trait_refs":[]}}}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":5}],"const_generics":[],"trait_refs":[]}}}}]}],"consts":[],"types":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"value":{"Deduplicated":5},"implied_trait_refs":[]},"kind":{"TraitType":[3,0]}}],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"id":1,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[],"const_generics":[],"trait_refs":[]}},"kind":{"TraitMethod":[3,0]}}],"vtable":{"id":1,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":1,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["string",0]},{"Ident":["String",0]},{"Impl":{"Trait":1}}],"span":{"Untagged":{"data":{"file_id":1,"beg":{"line":353,"col":0},"end":{"line":353,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Destruct","impl_trait":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":3}],"const_generics":[],"trait_refs":[]}},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"id":3,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[],"const_generics":[],"trait_refs":[]}},"kind":{"TraitMethod":[0,0]}}],"vtable":null},{"def_id":2,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["string",0]},{"Impl":{"Trait":2}}],"span":{"Untagged":{"data":{"file_id":1,"beg":{"line":2845,"col":0},"end":{"line":2845,"col":25}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Implements the `+` operator for concatenating two strings."},{"DocComment":""},{"DocComment":" This consumes the `String` on the left-hand side and re-uses its buffer (growing it if"},{"DocComment":" necessary). This is done to avoid allocating a new `String` and copying the entire contents on"},{"DocComment":" every operation, which would lead to *O*(*n*^2) running time when building an *n*-byte string by"},{"DocComment":" repeated concatenation."},{"DocComment":""},{"DocComment":" The string on the right-hand side is only borrowed; its contents are copied into the returned"},{"DocComment":" `String`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Concatenating two `String`s takes the first by value and borrows the second:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = String::from(\"hello\");"},{"DocComment":" let b = String::from(\" world\");"},{"DocComment":" let c = a + &b;"},{"DocComment":" // `a` is moved and can no longer be used here."},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you want to keep using the first `String`, you can clone it and append to the clone instead:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = String::from(\"hello\");"},{"DocComment":" let b = String::from(\" world\");"},{"DocComment":" let c = a.clone() + &b;"},{"DocComment":" // `a` is still valid here."},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Concatenating `&str` slices can be done by converting the first to a `String`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = \"hello\";"},{"DocComment":" let b = \" world\";"},{"DocComment":" let c = a.to_string() + b;"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":false},"is_local":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null},"src":"Normal","impl_trait":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":3},{"Deduplicated":11}],"const_generics":[],"trait_refs":[]}},"generics":{"regions":[{"index":0,"name":null,"variance":"Unknown","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[{"Value":[7,{"kind":{"BuiltinOrAuto":{"builtin_data":"MetaSized","parent_trait_refs":[],"types":[],"vtable":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":3}],"const_generics":[],"trait_refs":[]}}}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":3}],"const_generics":[],"trait_refs":[]}}}}]},{"Value":[8,{"kind":{"BuiltinOrAuto":{"builtin_data":"Sized","parent_trait_refs":[{"Value":[9,{"kind":{"BuiltinOrAuto":{"builtin_data":"MetaSized","parent_trait_refs":[],"types":[],"vtable":{"id":0,"generics":{"regions":[],"types":[{"Value":[25,{"Ref":["Erased",{"Deduplicated":5},"Shared"]}]}],"const_generics":[],"trait_refs":[]}}}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":25}],"const_generics":[],"trait_refs":[]}}}}]}],"types":[],"vtable":null}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Value":[26,{"Ref":[{"Var":{"Bound":[1,0]}},{"Deduplicated":5},"Shared"]}]}],"const_generics":[],"trait_refs":[]}}}}]},{"Value":[10,{"kind":{"BuiltinOrAuto":{"builtin_data":"Sized","parent_trait_refs":[{"Deduplicated":7}],"types":[],"vtable":null}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":3}],"const_generics":[],"trait_refs":[]}}}}]}],"consts":[],"types":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_t